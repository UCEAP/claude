#!/usr/bin/env bash
# scripts/jira-comment — post a markdown comment to a Jira ticket.
# Usage:
#   scripts/jira-comment <KEY> -m "comment text"
#   scripts/jira-comment <KEY> < comment.md
# Markdown is converted to ADF by md2adf.py alongside this script. Supported:
#   "# ".."###### "        — headings
#   "- " / "* "            — bullet list (2-space indent nests)
#   "1. "                  — ordered list
#   "| a | b |" + "|---|"  — table (first row becomes the header)
#   "> "                   — blockquote
#   ```lang ... ```        — code block
#   "---"                  — horizontal rule
#   anything else          — paragraph (single newlines become hard breaks)
# Inline: **strong**, *em*, _em_, `code`, ~~strike~~, [text](url). Inline code is
# literal, so `**this**` stays as written. Bare URLs are linkified by Jira.
# Requires env vars: JIRA_EMAIL, JIRA_API_TOKEN, JIRA_BASE_URL, and python3.
set -euo pipefail

key=""
message=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -m|--message) message="$2"; shift 2 ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)
      if [[ -z "$key" ]]; then key="$1"; shift
      else echo "Unexpected argument: $1" >&2; exit 2
      fi ;;
  esac
done

if [[ -z "$key" ]]; then
  echo "Usage: $(basename "$0") <KEY> [-m message]" >&2
  exit 2
fi

if [[ -z "$message" ]]; then
  if [[ -t 0 ]]; then
    echo "No message provided — use -m or pipe text on stdin." >&2
    exit 2
  fi
  message=$(cat)
fi

: "${JIRA_EMAIL:?JIRA_EMAIL not set}"
: "${JIRA_API_TOKEN:?JIRA_API_TOKEN not set}"
: "${JIRA_BASE_URL:?JIRA_BASE_URL not set}"

# Markdown → ADF. The conversion lives in md2adf.py next to this script; see the
# header above for the supported syntax. Keeping it in Python rather than jq is
# what makes inline marks (bold/code/links) and tables tractable to maintain.
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
md2adf="$script_dir/md2adf.py"

if [[ ! -f "$md2adf" ]]; then
  echo "Cannot find md2adf.py next to $(basename "$0") (looked in $script_dir)" >&2
  exit 1
fi

if ! adf=$(printf '%s' "$message" | python3 "$md2adf"); then
  echo "Failed to convert markdown to ADF." >&2
  exit 1
fi

payload=$(jq -nc --argjson body "$adf" '{body: $body}')

response=$(curl -sS -w $'\n%{http_code}' \
  -u "$JIRA_EMAIL:$JIRA_API_TOKEN" \
  -H 'Accept: application/json' -H 'Content-Type: application/json' \
  -X POST --data "$payload" \
  "$JIRA_BASE_URL/rest/api/3/issue/$key/comment")
status_code=${response##*$'\n'}
body=${response%$'\n'*}

if [[ "$status_code" != "201" ]]; then
  echo "Comment failed (HTTP $status_code) for $key" >&2
  echo "$body" >&2
  exit 1
fi

comment_id=$(jq -r '.id' <<<"$body")
echo "Posted comment $comment_id on $key"
